# Copy to .env and replace the secret; never commit the real .env.
SECRET_KEY=replace-with-a-unique-random-secret
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave unset for backend/db.sqlite3 during local development.
# DATABASE_PATH=
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets
ELEXON_TIMEOUT=90
ELEXON_RETRY_ATTEMPTS=3
APP_PORT=8000

# Structured application logs to stdout.
LOG_LEVEL=INFO

ELEXON_CIRCUIT_FAILURE_THRESHOLD=3
ELEXON_CIRCUIT_RECOVERY_TIMEOUT=60
